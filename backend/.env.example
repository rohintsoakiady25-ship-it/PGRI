# --- API ---
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=pgri
DB_PASSWORD=
DB_NAME=pgri
# Développement : crée les tables à partir des entités (false en production)
DB_SYNCHRONIZE=true

# --- Active Directory (LDAP / LDAPS) — LDAP_URL vide = connexion AD désactivée ---
# Deux modes : connexion directe « identifiant@LDAP_DOMAINE » (sans compte de service),
# ou compte de service (LDAP_BIND_DN + LDAP_BIND_PASSWORD) qui recherche puis vérifie.
# Exemple, AD de test MNP : LDAP_URL=ldaps://192.168.0.16:636, LDAP_DOMAINE=mnparks-clone.local,
#                           LDAP_BASE_DN=OU=MNP,OU=Utilisateurs,DC=mnparks-clone,DC=local
#                           LDAP_TLS_CA=certs/<certificat du DC>.pem
#                           LDAP_TLS_NOM_SERVEUR=mnparks-clone.mnparks-clone.local
LDAP_URL=
LDAP_DOMAINE=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_ATTRIBUT_LOGIN=sAMAccountName
LDAP_TLS_VERIFIER=true
# Certificat auto-signé du DC (fichier PEM, chemin relatif à backend/) et nom attendu si LDAP_URL est une IP
LDAP_TLS_CA=
LDAP_TLS_NOM_SERVEUR=
# Groupes AD donnant un rôle PGRI (facultatif) : nom du groupe (CN) ou DN complet
LDAP_GROUPE_ADMIN=
LDAP_GROUPE_LOGISTIQUE=
LDAP_GROUPE_MAGASINIER=
LDAP_GROUPE_ASSISTANTE_DIRECTION=

# --- JWT ---
# 32 caractères minimum
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Premier compte local administrateur (npm run seed:admin) ---
ADMIN_LOGIN=admin
ADMIN_MOT_DE_PASSE=
ADMIN_NOM=Administrateur PGRI

# --- E-mails automatiques (Microsoft Graph, application Azure AD) — vide = e-mails désactivés ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Boîte d'envoi (aussi l'adresse du compte local de test logistique)
MAIL_SENDER_ADDRESS=webmaster@mnparks.mg

# Adresse e-mail des comptes locaux de test (npm run seed:test) et du compte admin local (npm run seed:admin)
EMAIL_COMPTES_TEST=
ADMIN_EMAIL=

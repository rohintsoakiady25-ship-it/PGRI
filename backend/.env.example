# --- API ---
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=pgri
DB_PASSWORD=
DB_NAME=pgri
# Développement : crée les tables à partir des entités (false en production)
DB_SYNCHRONIZE=true

# --- Active Directory (LDAPS) ---
LDAP_URL=ldaps://ad.mnp.mg:636
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_ATTRIBUT_LOGIN=sAMAccountName
LDAP_TLS_VERIFIER=true
# DN des groupes AD donnant un rôle PGRI (facultatif)
LDAP_GROUPE_ADMIN=
LDAP_GROUPE_LOGISTIQUE=
LDAP_GROUPE_MAGASINIER=
LDAP_GROUPE_ASSISTANTE_DIRECTION=

# --- JWT ---
# 32 caractères minimum
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Premier compte local administrateur (npm run seed:admin) ---
ADMIN_LOGIN=admin
ADMIN_MOT_DE_PASSE=
ADMIN_NOM=Administrateur PGRI

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=pgri@mnp.mg
